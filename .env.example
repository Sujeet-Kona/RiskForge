# RiskForge — local environment template.
#
# Copy to .env and change the values. .env is git-ignored; this file is not,
# so it must never hold a real credential.

# Audit store (Phase 7). The only database RiskForge connects to.
# psycopg 3 is the driver; a bare postgresql:// URL is normalized to it.
DATABASE_URL=postgresql+psycopg://riskforge:riskforge@localhost:5432/riskforge

# Credentials for the local PostgreSQL container in docker-compose.yml.
# These match the default DATABASE_URL above and are for local development only.
POSTGRES_USER=riskforge
POSTGRES_PASSWORD=riskforge
POSTGRES_DB=riskforge
POSTGRES_PORT=5432
