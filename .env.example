# RiskForge — local environment template.
#
# Copy to .env and change the values. .env is git-ignored; this file is not,
# so it must never hold a real credential.

# Audit store (Phase 7). The only database RiskForge connects to.
# psycopg 3 is the driver; a bare postgresql:// URL is normalized to it.
DATABASE_URL=postgresql+psycopg://riskforge:riskforge@localhost:5432/riskforge

# Credentials for the local PostgreSQL container in docker-compose.yml.
# These match the default DATABASE_URL above and are for local development only.
POSTGRES_USER=riskforge
POSTGRES_PASSWORD=riskforge
POSTGRES_DB=riskforge
POSTGRES_PORT=5432

# Experiment and model-lifecycle tracking (Phase 8), local development only.
# Nothing on the inference path reads these: the FastAPI service loads the
# Phase 6 serving artifact from disk and never contacts a tracking store.
# tracking/config.py accepts only local backends — a `file:` directory or an
# absolute `sqlite:////...` database — and refuses any URI that names a host or
# carries credentials. The default store is generated state and is gitignored.
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=riskforge-xgboost-lifecycle
MLFLOW_REGISTERED_MODEL_NAME=riskforge-fraud-model

# MLflow 3.x puts its filesystem backend in maintenance mode and refuses it
# unless this is set. tracking/config.py sets it itself for a `file:` store, so
# it only needs to be here if a tool other than the training script touches the
# store directly.
MLFLOW_ALLOW_FILE_STORE=true
